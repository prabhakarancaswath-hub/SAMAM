# Supabase public project settings (safe for browser use when paired with RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Google Maps browser key (restrict by HTTP referrer/domain)
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Google Gemini API key for local dev or build-time injection.
# (Users can also connect their free API key directly in the Geetha UI via browser localStorage)
VITE_GEMINI_API_KEY=

# Public API URL for the Geetha backend (safe to expose in frontend builds).
# Leave blank to use direct Gemini API or local rule-based fallback.
VITE_GEETHA_API_URL=

# Server-only variables (for Vercel or Node backend):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# OLLAMA_API_KEY=
# OLLAMA_MODEL=deepseek-v4.1-flash
# SAMAM_ALLOWED_ORIGIN=https://prabhakarancaswath-hub.github.io
