# Supabase public project settings (safe for browser use when paired with RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Google Maps browser key (restrict by HTTP referrer/domain)
VITE_GOOGLE_MAPS_API_KEY=

# Public API URL for the Geetha backend (safe to expose in frontend builds).
# Leave blank to keep the existing local/rule-based fallback.
VITE_GEETHA_API_URL=

# Server-only variables. Configure these in your backend hosting dashboard; never add VITE_ prefix:
# OLLAMA_API_KEY
# OLLAMA_MODEL=deepseek-v4.1-flash
# SAMAM_ALLOWED_ORIGIN=https://your-samam-site.example
